# Backend Environment Variables (.env.example)
# Copy this file to .env and fill in the values
# This file documents all required and optional environment variables for VNotes backend

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# PORT: The port on which the backend server listens
# Default: 3001
# Examples: 3001 (development), 8080 (production)
PORT=3001

# NODE_ENV: Environment mode for the application
# Valid values: development, staging, production
# Controls logging verbosity, error detail level, and optimization settings
# Default: development
NODE_ENV=development

# ============================================================================
# CORS CONFIGURATION (Cross-Origin Resource Sharing)
# ============================================================================

# CORS_ORIGIN: The frontend URL allowed to make requests to this backend
# This is a security measure to prevent unauthorized access from other origins
# Set to your frontend URL in production (e.g., https://app.example.com)
# For development, typically http://localhost:3000
# Multiple origins: Use comma-separated values or configure in server.ts
CORS_ORIGIN=http://localhost:3000

# ============================================================================
# FILE UPLOAD CONFIGURATION
# ============================================================================

# UPLOADS_DIR: Directory where uploaded files (audio, video) are stored
# Default: uploads
# The server will create this directory if it doesn't exist
UPLOADS_DIR=uploads

# MAX_FILE_SIZE: Maximum file size for uploads in bytes
# Default: 524288000 (500 MB)
# Formula: (size in MB) * 1024 * 1024
# Examples:
#   100MB = 104857600
#   500MB = 524288000
#   1GB = 1073741824
MAX_FILE_SIZE=524288000

# ============================================================================
# GOOGLE OAUTH 2.0 CONFIGURATION (Required for authentication feature)
# ============================================================================

# GOOGLE_OAUTH_CLIENT_ID: OAuth 2.0 Client ID from Google Cloud Console
# Instructions to obtain:
#   1. Go to https://console.cloud.google.com
#   2. Create a new project or select existing one
#   3. Enable Google+ API
#   4. Go to Credentials → Create Credentials → OAuth 2.0 Client ID
#   5. Choose Application Type: Web Application
#   6. Add Authorized Redirect URIs (see GOOGLE_OAUTH_CALLBACK_URI)
#   7. Copy the Client ID here
# Format: [alphanumeric]-[alphanumeric].apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id-here

# GOOGLE_OAUTH_CLIENT_SECRET: OAuth 2.0 Client Secret from Google Cloud Console
# Obtained from same steps as CLIENT_ID (step 7, copy Secret)
# SECURITY WARNING: Keep this secret! Never commit to version control.
# Use strong secret management in production (HashiCorp Vault, AWS Secrets Manager, etc.)
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret-here

# GOOGLE_OAUTH_CALLBACK_URI: Redirect URI after OAuth authentication
# This URL must exactly match the authorized redirect URI registered in Google Cloud Console
# Format: https://[backend-domain]/auth/oauth/callback
# Examples:
#   Local: http://localhost:3001/auth/oauth/callback
#   Staging: https://api-staging.example.com/auth/oauth/callback
#   Production: https://api.example.com/auth/oauth/callback
# Note: Must use HTTPS in production for security
GOOGLE_OAUTH_CALLBACK_URI=http://localhost:3001/auth/oauth/callback

# ============================================================================
# JWT (JSON Web Token) CONFIGURATION (Required for session tokens)
# ============================================================================

# JWT_SECRET: Secret key used to sign and verify JWT session tokens
# CRITICAL FOR SECURITY: Must be a cryptographically secure random string of at least 32 characters
# Generate securely with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or use: openssl rand -hex 32
# SECURITY WARNING:
#   - Never commit to version control
#   - Use strong secret management in production
#   - Rotate periodically in production
#   - Different secret for each environment (dev/staging/prod)
#   - Minimum 256 bits of entropy (32 bytes hex = 64 characters)
JWT_SECRET=your-256-bit-jwt-secret-here

# JWT_EXPIRATION: Session token expiration time in seconds
# Default: 86400 (24 hours)
# Common values:
#   3600 = 1 hour (short-lived, good for security)
#   86400 = 24 hours (default, balanced approach)
#   604800 = 7 days (long-lived, convenient for users)
# Note: Longer expiration means longer attack window if token is compromised
JWT_EXPIRATION=86400

# ============================================================================
# RATE LIMITING CONFIGURATION (Security - prevents abuse and DDoS attacks)
# ============================================================================

# RATE_LIMIT_OAUTH_WINDOW: Time window for OAuth rate limiting in milliseconds
# Default: 300000 (5 minutes)
# This defines how long to count requests before resetting the counter
# Formula: minutes * 60 * 1000
# Note: Currently configured as: 5 minutes per IP limit (5 attempts)
RATE_LIMIT_OAUTH_WINDOW=300000

# RATE_LIMIT_OAUTH_MAX: Maximum OAuth attempts allowed per IP within the window
# Default: 5
# Protects against brute-force attacks on OAuth endpoint
# If limit exceeded, returns 429 Too Many Requests
# Requirement 10.10: OAuth endpoints should be rate-limited to prevent brute-force attacks
RATE_LIMIT_OAUTH_MAX=5

# RATE_LIMIT_LOGOUT_WINDOW: Time window for logout rate limiting in milliseconds
# Default: 3600000 (1 hour)
# Formula: hours * 60 * 60 * 1000
# Note: Currently configured as: 1 hour per IP limit (10 attempts)
RATE_LIMIT_LOGOUT_WINDOW=3600000

# RATE_LIMIT_LOGOUT_MAX: Maximum logout attempts allowed per IP within the window
# Default: 10
# Protects against logout endpoint abuse and potential account disruption
# If limit exceeded, returns 429 Too Many Requests
# Requirement 10.10: Logout endpoints should be rate-limited to prevent abuse
RATE_LIMIT_LOGOUT_MAX=10

# ============================================================================
# SUPABASE CONFIGURATION (Required for user profiles and recording metadata)
# ============================================================================

# SUPABASE_URL: API URL for your Supabase project
# Obtained from: Supabase Dashboard → Project Settings → API → Project URL
# Format: https://[project-ref].supabase.co
# Example: https://myproject-abc123.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# SUPABASE_ANON_KEY: Anonymous/public key for Supabase API
# Obtained from: Supabase Dashboard → Project Settings → API → anon (public) key
# Used for client-side operations (public data, user-specific data with RLS)
# SECURITY NOTE: This key is safe to expose in frontend code (it's anonmous-only access)
SUPABASE_ANON_KEY=your-anon-key-here

# SUPABASE_SERVICE_ROLE_KEY: Server-side service role key for Supabase
# Obtained from: Supabase Dashboard → Project Settings → API → service_role (secret) key
# Used for privileged backend operations that bypass RLS (Row-Level Security)
# SECURITY WARNING: Keep this secret! Never expose to frontend. Never commit to version control.
# Use strong secret management in production
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================

# ELEVENLABS_API_KEY: API key for ElevenLabs text-to-speech service
# Obtained from: https://www.elevenlabs.io → Account → API Keys
# Used for transcription and synthesis features
# Optional: Only required if transcription features are enabled
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# ============================================================================
# SECURITY BEST PRACTICES SUMMARY
# ============================================================================

# 1. SECRETS MANAGEMENT
#    - Use environment-specific .env files (do NOT commit to version control)
#    - In production, use secure secret management (AWS Secrets Manager, HashiCorp Vault, etc.)
#    - Rotate secrets regularly
#    - Use separate secrets for dev/staging/production

# 2. VALIDATION ON STARTUP
#    - Backend validates all required environment variables at startup
#    - Missing required variables will prevent server from starting
#    - Check server logs for missing variable errors

# 3. SECURE DEFAULTS
#    - JWT uses HTTPS-only transmission in production
#    - Tokens include expiration to limit attack window
#    - Rate limiting prevents brute-force and DDoS attacks
#    - CORS restricts access to configured frontend origin

# 4. MONITORING
#    - Monitor auth endpoint logs for rate limit violations
#    - Monitor for unusual patterns (multiple login failures, etc.)
#    - Set up alerts for security events

# 5. DEPLOYMENT CHECKLIST
#    - [ ] Generate strong JWT_SECRET (minimum 32 characters, 256 bits)
#    - [ ] Register production domain with Google OAuth Console
#    - [ ] Set GOOGLE_OAUTH_CALLBACK_URI to production domain (HTTPS required)
#    - [ ] Configure CORS_ORIGIN to production frontend domain
#    - [ ] Verify SUPABASE_URL and keys are for production project
#    - [ ] Confirm NODE_ENV is set to production
#    - [ ] Enable HTTPS on backend server
#    - [ ] Set up proper logging and monitoring
