# Backend Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# File Upload Configuration
UPLOADS_DIR=uploads
MAX_FILE_SIZE=524288000

# Google OAuth Configuration (Required for authentication feature)
# Get these values from Google Cloud Console:
# 1. Create a new OAuth 2.0 Application
# 2. Set authorized redirect URIs to include GOOGLE_OAUTH_CALLBACK_URI
# 3. Copy Client ID and Client Secret to these variables
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id-here
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret-here
GOOGLE_OAUTH_CALLBACK_URI=http://localhost:3001/auth/oauth/callback

# JWT Configuration (Required for session tokens)
# JWT_SECRET should be a random 256-bit string (min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-256-bit-jwt-secret-here
JWT_EXPIRATION=86400

# Supabase Configuration (Required for user profiles and recording metadata)
# Get these values from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ElevenLabs API (for transcription feature)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
