{
  "name": "vnotes",
  "version": "1.0.0",
  "description": "VNotes - Voice Notes Application",
  "private": true,
  "scripts": {
    "predev": "node scripts/preflightCheck.js",
    "dev": "npm run predev && concurrently \"cd backend && npm run dev\" \"cd frontend && npm run dev\"",
    "build": "concurrently \"cd backend && npm run build\" \"cd frontend && npm run build\"",
    "start": "node backend/dist/server.js",
    "test": "concurrently \"npm run test:backend\" \"npm run test:frontend\"",
    "test:backend": "cd backend && npm run test",
    "test:frontend": "cd frontend && npm run test",
    "lint": "concurrently \"npm run lint:backend\" \"npm run lint:frontend\"",
    "lint:backend": "cd backend && npm run lint",
    "lint:frontend": "cd frontend && npm run lint",
    "typecheck": "concurrently \"cd backend && tsc --noEmit\" \"cd frontend && tsc --noEmit\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
